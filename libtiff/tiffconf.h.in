/**
 * @file tiffconf.h
 * @brief Provide configured integer types and legacy compatibility features.
 *
 * Generated for the selected build. Prefer standard integer types in new
 * application code. Feature macros are retained for compatibility and are not
 * a portable runtime capability query; use TIFFIsCODECConfigured() for codecs.
 * An undefined conditional macro indicates that its feature was not enabled.
 */

/* clang-format off */
/* clang-format disabled because CMake scripts are very sensitive to the
 * formatting of this file. configure_file variables of type "@VAR@" are
 * modified by clang-format and won't be substituted.
 */

#ifndef _TIFFCONF_
#define _TIFFCONF_


#include <stddef.h>
#include <stdint.h>
#include <inttypes.h>


/** @addtogroup libtiff_public_configuration
 * @{ */

/** @brief Define the configured signed 16-bit integer type.
 */
#undef TIFF_INT16_T

/** @brief Define the configured signed 32-bit integer type.
 */
#undef TIFF_INT32_T

/** @brief Define the configured signed 64-bit integer type.
 */
#undef TIFF_INT64_T

/** @brief Define the configured signed 8-bit integer type.
 */
#undef TIFF_INT8_T

/** @brief Define the configured unsigned 16-bit integer type.
 */
#undef TIFF_UINT16_T

/** @brief Define the configured unsigned 32-bit integer type.
 */
#undef TIFF_UINT32_T

/** @brief Define the configured unsigned 64-bit integer type.
 */
#undef TIFF_UINT64_T

/** @brief Define the configured unsigned 8-bit integer type.
 */
#undef TIFF_UINT8_T

/** @brief Define the signed addressing-size type used for tmsize_t.
 */
#undef TIFF_SSIZE_T

/* Compatibility stuff. */

/** @brief Indicate IEEE floating-point representation when defined to 1.
 */
#undef HAVE_IEEEFP

/** @brief Retain the legacy least-significant-bit-first fill-order constant.
 *
 * Fixed at FILLORDER_LSB2MSB, independently of CPU byte order. The deprecated
 * H open mode now selects FILLORDER_MSB2LSB and does not consult this macro.
 * Do not use this constant to detect CPU byte order or the file's FillOrder.
 */
#define HOST_FILLORDER FILLORDER_LSB2MSB

/** @brief Indicate native CPU byte order: 1 for big-endian, 0 for little-endian.
 */
#undef HOST_BIGENDIAN

/** @brief Indicate inclusion of CCITT Group 3 and Group 4 codecs when defined.
 */
#undef CCITT_SUPPORT

/** @brief Indicate inclusion of the JPEG codec when defined.
 */
#undef JPEG_SUPPORT

/** @brief Indicate inclusion of the JBIG codec when defined.
 */
#undef JBIG_SUPPORT

/** @brief Indicate inclusion of the LERC codec when defined.
 */
#undef LERC_SUPPORT

/** @brief Indicate inclusion of the LogLuv codec when defined.
 */
#undef LOGLUV_SUPPORT

/** @brief Indicate inclusion of the LZW codec when defined.
 */
#undef LZW_SUPPORT

/** @brief Indicate inclusion of the NeXT 2-bit RLE codec when defined.
 */
#undef NEXT_SUPPORT

/** @brief Indicate inclusion of the old-style JPEG reader when defined.
 */
#undef OJPEG_SUPPORT

/** @brief Indicate inclusion of the PackBits codec when defined.
 */
#undef PACKBITS_SUPPORT

/** @brief Indicate inclusion of the PixarLog codec when defined.
 */
#undef PIXARLOG_SUPPORT

/** @brief Indicate inclusion of the ThunderScan codec when defined.
 */
#undef THUNDER_SUPPORT

/** @brief Indicate inclusion of Deflate compression support when defined.
 */
#undef ZIP_SUPPORT

/** @brief Indicate use of libdeflate for Deflate compression when defined.
 */
#undef LIBDEFLATE_SUPPORT

/** @brief Define the default strip-chopping flag when strip chopping is enabled.
 *
 * Enables treating a single uncompressed strip as smaller strips internally;
 * the open-mode options can override the default.
 */
#undef STRIPCHOP_DEFAULT

/** @brief Indicate support for SubIFD tag handling when defined.
 */
#undef SUBIFD_SUPPORT

/** @brief Enable the RGBA reader's fallback alpha interpretation when defined.
 *
 * For an RGB image with exactly four samples per pixel and no declared extra
 * samples, the fourth sample is treated as associated alpha.
 */
#undef DEFAULT_EXTRASAMPLE_AS_ALPHA

/** @brief Enable JPEG-stream subsampling checks when defined.
 *
 * When the YCbCrSubsampling tag is absent from a contiguous three-sample
 * YCbCr JPEG image, the JPEG codec reads the sampling factors from the JPEG
 * stream instead of assuming the TIFF default of 2,2.
 */
#undef CHECK_JPEG_YCBCR_SUBSAMPLING

/** @brief Indicate support for Microsoft Document Imaging signatures when defined.
 */
#undef MDI_SUPPORT

/*
 * Feature support definitions.
 * XXX: These macros are obsoleted. Don't use them in your apps!
 * Macros stays here for backward compatibility and should be always defined.
 */
/** @brief Retain the obsolete colorimetry feature marker.
 *
 * Always defined for compatibility; do not use as a capability test.
 */
#define COLORIMETRY_SUPPORT
/** @brief Retain the obsolete YCbCr feature marker.
 *
 * Always defined for compatibility; do not use as a capability test.
 */
#define YCBCR_SUPPORT
/** @brief Retain the obsolete CMYK feature marker.
 *
 * Always defined for compatibility; do not use as a capability test.
 */
#define CMYK_SUPPORT
/** @brief Retain the obsolete ICC profiles feature marker.
 *
 * Always defined for compatibility; do not use as a capability test.
 */
#define ICC_SUPPORT
/** @brief Retain the obsolete Photoshop metadata feature marker.
 *
 * Always defined for compatibility; do not use as a capability test.
 */
#define PHOTOSHOP_SUPPORT
/** @brief Retain the obsolete IPTC metadata feature marker.
 *
 * Always defined for compatibility; do not use as a capability test.
 */
#define IPTC_SUPPORT

/** @} */

#endif /* _TIFFCONF_ */

/* clang-format on */
